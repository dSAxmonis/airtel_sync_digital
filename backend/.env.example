# Copy to backend/.env and fill in. Never commit the real .env.
NODE_ENV=production
PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/udyam_digital
# Comma-separated list of origins allowed to call the API (your site URL)
CLIENT_URL=https://your-domain.example

# Required in production: long random values (at least 12 characters; 32+ recommended)
JWT_SECRET=
DATA_ENCRYPTION_KEY=
ADMIN_EMAIL=admin@your-domain.example
ADMIN_PASSWORD=

# Demo shortcuts. Default: on in development, off in production.
DEMO_MODE=false
OTP_DEV_MODE=false
DEMO_STAFF_PASSWORD=

# Optional: Cloudflare R2 for document storage (local disk is used when blank)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_ENDPOINT=

# Optional: Claude for the plan advisor (rule-based advisor is used when blank)
ADVISOR_AI=auto
ANTHROPIC_API_KEY=

# Optional: WhatsApp Cloud API (in-app simulator is used when blank)
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_API_VERSION=v21.0
