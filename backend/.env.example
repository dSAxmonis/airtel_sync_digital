# Copy to backend/.env and fill in. Never commit the real .env.
NODE_ENV=production
PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/udyam_digital
# Your site's public URL (used for CORS, the CSRF origin check and links in WhatsApp messages)
CLIENT_URL=https://your-domain.example
# Extra browser origins allowed to call the API with cookies, comma-separated.
# One wildcard label is allowed, e.g. https://*.vercel.app for preview deployments.
CORS_ORIGINS=
# Login cookie mode: lax (frontend reaches the API on the same site, e.g. through a /api rewrite)
# or none (frontend calls the API on another domain; the cookie is then always Secure)
COOKIE_SAMESITE=lax

# Required in production: long random values (at least 12 characters; 32+ recommended)
JWT_SECRET=
DATA_ENCRYPTION_KEY=
ADMIN_EMAIL=admin@your-domain.example
ADMIN_PASSWORD=

# Demo shortcuts. Default: on in development, off in production.
DEMO_MODE=false
OTP_DEV_MODE=false
DEMO_STAFF_PASSWORD=

# Optional: Cloudflare R2 for document storage (local disk is used when blank)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_ENDPOINT=

# Optional: Gemini runs the advisor and the second reader for KYC documents (Google AI Studio key).
# Without it the advisor uses its local rules and documents are read by server OCR only.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
GEMINI_FALLBACK_MODEL=gemini-3.1-flash-lite

# Optional: Claude for the plan advisor (used when no Gemini key is set)
ADVISOR_AI=auto
ANTHROPIC_API_KEY=

# Optional: WhatsApp Cloud API (in-app simulator is used when blank)
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_API_VERSION=v21.0
